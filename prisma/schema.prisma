generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEVELOPER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now())
  apiKeys      ApiKey[]
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  label      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model TechnologyCategory {
  id           String       @id @default(uuid())
  name         String
  aliases      String[]     @default([])
  isActiveInV1 Boolean      @default(false)
  technologies Technology[]
}

model Technology {
  id          String             @id @default(uuid())
  name        String
  aliases     String[]           @default([])
  description String?
  categoryId  String
  category    TechnologyCategory @relation(fields: [categoryId], references: [id])
  policies    PolicyTechnology[]
}

model Country {
  id                 String         @id @default(uuid())
  name               String
  isoCode            String         @unique
  tierClassification String?
  companies          Company[]
  jurisdictions      Jurisdiction[]
}

model Company {
  id               String          @id @default(uuid())
  name             String
  hqCountryId      String
  hqCountry        Country         @relation(fields: [hqCountryId], references: [id])
  entityListStatus String?
  aliases          String[]
  policies         PolicyCompany[]
}

enum PolicyStatus {
  ACTIVE
  RESCINDED
  CONTESTED
  SUPERSEDED
  DRAFT
}

enum IngestionSourceType {
  FEDERAL_REGISTER_API
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum IngestionDocumentStatus {
  NEW
  REVIEWED
  IMPORTED
  SKIPPED
}

model Policy {
  id             String             @id @default(uuid())
  title          String
  summary        String?
  controlNumber  String?
  effectiveDate  DateTime?
  status         PolicyStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sources        PolicySource[]
  documents      Document[]
  jurisdictions  Jurisdiction[]
  technologies   PolicyTechnology[]
  companies      PolicyCompany[]
  revisions      PolicyRevision[]
  timelineEvents TimelineEvent[]
}

model PolicyTechnology {
  id           String     @id @default(uuid())
  policyId     String
  policy       Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([policyId, technologyId])
}

model PolicyCompany {
  id        String   @id @default(uuid())
  policyId  String
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([policyId, companyId])
}

model PolicySource {
  id            String    @id @default(uuid())
  policyId      String
  policy        Policy    @relation(fields: [policyId], references: [id])
  sourceName    String
  sourceUrl     String?
  publishedDate DateTime?
}

model Document {
  id            String    @id @default(uuid())
  policyId      String
  policy        Policy    @relation(fields: [policyId], references: [id])
  title         String
  url           String?
  documentType  String
  publishedDate DateTime?
}

model RestrictionType {
  id            String         @id @default(uuid())
  name          String
  description   String?
  jurisdictions Jurisdiction[]
}

model Jurisdiction {
  id                String          @id @default(uuid())
  policyId          String
  policy            Policy          @relation(fields: [policyId], references: [id])
  countryId         String
  country           Country         @relation(fields: [countryId], references: [id])
  restrictionTypeId String
  restrictionType   RestrictionType @relation(fields: [restrictionTypeId], references: [id])
}

model PolicyRevision {
  id             String        @id @default(uuid())
  policyId       String
  policy         Policy        @relation(fields: [policyId], references: [id])
  revisionDate   DateTime
  changeSummary  String?
  previousStatus PolicyStatus?
  newStatus      PolicyStatus?
}

model TimelineEvent {
  id          String   @id @default(uuid())
  policyId    String?
  policy      Policy?  @relation(fields: [policyId], references: [id])
  eventDate   DateTime
  eventType   String
  description String?
  sourceName  String?
  sourceUrl   String?
}

model IngestionSource {
  id            String              @id @default(uuid())
  name          String
  sourceType    IngestionSourceType
  baseUrl       String
  query         Json
  isActive      Boolean             @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  runs          IngestionRun[]
  documents     IngestionDocument[]

  @@unique([sourceType, name])
}

model IngestionRun {
  id               String              @id @default(uuid())
  sourceId         String
  source           IngestionSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status           IngestionRunStatus  @default(RUNNING)
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?
  documentsFound   Int                 @default(0)
  documentsCreated Int                 @default(0)
  documentsUpdated Int                 @default(0)
  errorMessage     String?
  documents        IngestionDocument[]
}

model IngestionDocument {
  id                     String                  @id @default(uuid())
  sourceId               String
  source                 IngestionSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runId                  String?
  run                    IngestionRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  externalId             String
  title                  String
  abstract               String?
  documentType           String?
  htmlUrl                String?
  pdfUrl                 String?
  publicationDate        DateTime?
  agencyNames            String[]
  matchedTerms           String[]
  matchedCategoryNames   String[]                @default([])
  matchedTechnologyNames String[]                @default([])
  rawPayload             Json
  status                 IngestionDocumentStatus @default(NEW)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([sourceId, externalId])
  @@index([publicationDate])
  @@index([status])
}
