generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(DEVELOPER)
  createdAt    DateTime  @default(now())
  apiKeys      ApiKey[]
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  label      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model TechnologyCategory {
  id           String       @id @default(uuid())
  name         String
  isActiveInV1 Boolean      @default(false)
  technologies Technology[]
}

model Technology {
  id          String             @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    TechnologyCategory @relation(fields: [categoryId], references: [id])
}

model Country {
  id                 String    @id @default(uuid())
  name               String
  isoCode            String    @unique
  tierClassification String?
  companies          Company[]
}

model Company {
  id               String   @id @default(uuid())
  name             String
  hqCountryId      String
  hqCountry        Country  @relation(fields: [hqCountryId], references: [id])
  entityListStatus String?
  aliases          String[]
}
